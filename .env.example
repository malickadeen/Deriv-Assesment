# --- OpenRouter (default): OpenAI-compatible, use gpt-4o-mini ---
OPENROUTER_API_KEY=your_openrouter_api_key_here
MODEL=openai/gpt-4o-mini
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1   # override if needed

# --- Anthropic direct (leave OPENROUTER_API_KEY unset to use this) ---
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# MODEL=anthropic:claude-sonnet-5

# --- Qdrant (RAG server) ---
# Cloud/server: set the URL (and API key for Qdrant Cloud).
# QDRANT_URL=https://your-cluster.cloud.qdrant.io:6333
# QDRANT_API_KEY=your_qdrant_api_key_here

# Local fallback (used when QDRANT_URL is unset): on-disk storage dir.
# QDRANT_PATH=./qdrant_data

# Default collection name.
# QDRANT_COLLECTION=documents

# --- Qdrant Cloud ---
# QDRANT_URL=https://your-cluster.cloud.qdrant.io:6333
# QDRANT_API_KEY=your_qdrant_api_key_here
# QDRANT_COLLECTION=deriv